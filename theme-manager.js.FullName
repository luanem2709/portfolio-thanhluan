    .theme-controls {
        position: fixed;
        top: 96px;
        right: 28px;
        z-index: 950;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .theme-toggle,
    .theme-selector-btn {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--surface, #ffffff);
        border: 1px solid var(--line, #dbeafe);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: var(--shadow-sm, 0 8px 24px rgba(14, 116, 184, 0.08));
    }

    .theme-toggle:hover,
    .theme-selector-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md, 0 12px 28px rgba(14, 116, 184, 0.14));
        border-color: var(--brand, #0284c7);
    }

    .theme-toggle svg,
    .theme-selector-btn svg {
        width: 21px;
        height: 21px;
        color: var(--text-strong, #0b1f33);
    }

    .theme-toggle .moon-icon {
        display: block;
    }

    .theme-toggle .sun-icon {
        display: none;
    }

    body.dark-mode .theme-toggle .moon-icon {
        display: none;
    }

    body.dark-mode .theme-toggle .sun-icon {
        display: block;
    }

    .theme-selector {
        position: relative;
    }

    .theme-dropdown {
        position: absolute;
        right: 56px;
        top: 0;
        background: var(--surface, #ffffff);
        border-radius: 14px;
        padding: 8px;
        min-width: 196px;
        border: 1px solid var(--line, #dbeafe);
        box-shadow: var(--shadow-md, 0 16px 36px rgba(14, 116, 184, 0.14));
        opacity: 0;
        visibility: hidden;
        transform: translateX(8px);
        transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    }

    .theme-dropdown.show {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
    }

    .theme-option {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 10px;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 9px;
        cursor: pointer;
        transition: background 0.18s ease, border-color 0.18s ease;
        color: var(--text-strong, #0b1f33);
    }

    .theme-option:hover {
        background: var(--surface-muted, #eef6ff);
        border-color: var(--line, #dbeafe);
    }

    .theme-option.active {
        background: var(--brand-soft, #e0f2fe);
        border-color: color-mix(in srgb, var(--brand, #0284c7) 30%, transparent);
    }

    .theme-preview {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 2px solid var(--surface, #ffffff);
        box-shadow: 0 0 0 1px var(--line, #dbeafe);
        flex-shrink: 0;
    }

    .theme-name {
        font-size: 13.5px;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .theme-controls {
            top: auto;
            bottom: 20px;
            right: 68px;
            flex-direction: row;
            gap: 8px;
        }

        .theme-toggle,
        .theme-selector-btn {
            width: 42px;
            height: 42px;
        }

        .theme-toggle svg,
        .theme-selector-btn svg {
            width: 19px;
            height: 19px;
        }

        .theme-dropdown {
            right: 0;
            top: auto;
            bottom: 52px;
        }
    }
`,document.head.appendChild(themeStyles),document.readyState==="loading"?document.addEventListener("DOMContentLoaded",()=>{new ThemeManager}):new ThemeManager;
