-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.achievement-card{background:var(--surface);border-radius:20px;overflow:hidden;transition:transform .22s var(--ease-out),box-shadow .22s var(--ease-out),border-color .22s var(--ease-out);border:1px solid color-mix(in srgb,var(--line) 88%,transparent);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;cursor:pointer}.achievement-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:color-mix(in srgb,var(--brand) 28%,var(--line))}.achievement-image{position:relative;height:235px;padding:12px;overflow:hidden;background:var(--surface-muted);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:center}.achievement-image img{width:100%;height:100%;object-fit:contain;border-radius:10px;transition:transform .25s var(--ease-out)}.achievement-card:hover .achievement-image img{transform:scale(1.03)}.achievement-badge{position:absolute;top:14px;right:14px;width:40px;height:40px;background:linear-gradient(135deg,var(--brand-hover),var(--brand));border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--on-brand);font-size:16px;z-index:2}.achievement-content{padding:20px 22px;flex:1;display:flex;flex-direction:column;gap:6px}.achievement-content h3{color:var(--text-strong);font-size:18px;line-height:1.35}.issuer{font-size:14px;color:var(--brand);font-weight:600}.achievement-content .date{font-size:13px;color:var(--muted);margin-top:auto;padding-top:6px}.cert-lightbox{position:fixed;inset:0;z-index:10050;background:#030f18c7;display:none;align-items:center;justify-content:center;padding:24px}.cert-lightbox.open{display:flex}.cert-lightbox-inner{position:relative;max-width:min(920px,94vw);max-height:90vh;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:18px;display:flex;flex-direction:column;gap:12px;box-shadow:0 24px 64px #05141f59}.cert-lightbox-inner img{max-width:100%;max-height:75vh;object-