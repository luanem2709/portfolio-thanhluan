out)}.social-links-contact a:hover{background:var(--brand);border-color:var(--brand);color:var(--on-brand);transform:translateY(-2px);box-shadow:var(--shadow-sm)}.contact-form{background:var(--surface);padding:34px;border-radius:20px;border:1px solid var(--line);box-shadow:var(--shadow-sm)}.form-group{position:relative;margin-bottom:20px}.form-group i{position:absolute;left:18px;top:17px;transform:none;color:var(--muted);pointer-events:none;z-index:2}.form-group input,.form-group textarea{width:100%;padding:14px 18px 14px 48px;background:var(--surface-muted);border:1px solid var(--line-strong);border-radius:12px;color:var(--text-strong);font-family:inherit;font-size:15px;transition:border-color .2s var(--ease-out),box-shadow .2s var(--ease-out),background .2s var(--ease-out)}.form-group textarea{resize:vertical;min-height:130px}.form-group input::placeholder,.form-group textarea::placeholder{color:var(--muted);opacity:.85}.form-group input:focus,.form-group textarea:focus{outline:none;background:var(--surface);border-color:var(--brand);box-shadow:var(--focus-ring)}.footer{position:relative;z-index:2;background:radial-gradient(circle at 18% -30%,rgba(56,189,248,.22),transparent 34rem),linear-gradient(155deg,#0b2d4d,#071d33);color:#e6f1fce0;padding:60px 0 30px;border-top:1px solid rgba(56,189,248,.24)}.footer-section h3{color:#f6faff;font-size:20px;margin-bottom:10px}.footer-section h4{color:#f6faff;font-size:16px;margin-bottom:16px}.footer-section p{color:#c0d4e8;margin-bottom:18px;font-size:14px;line-height:1.6}.footer-content{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px;margin-bottom:40px}.footer-social{display:flex;gap:14px}.footer-social a{width:40px;height:40px;background:#ffffff14;border:1px solid rgba(255,255,255,.16);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#e6f1fc;transition:background .2s ease,border-color .2s ease,transform .2s ease}.footer-social a:hover{background:#0284c7;border-color:#38bdf8;color:#fff;transform:translateY(-2px)}.footer-links ul,.footer-contact ul{list-style:none}.footer-links li,.footer-contact li{margin-bottom:10px;font-size:14px;color:#c0d4e8;display:flex;align-items:center;gap:10px}.footer-links a:hover{color:#7dd3fc}.footer-contact i{color:#38bdf8;width:16px;text-align:center;flex-shrink:0}.footer-bottom{text-align:center;padding-top:28px;border-top:1px solid rgba(255,255,255,.12)}.footer-bottom p{font-size:13px;color:#98b1c9;margin-bottom:6px}.footer-bottom a{color:#c0d4e8}.footer-bottom a:hover{color:#7dd3fc}.scroll-top{position:fixed;bottom:28px;right:28px;width:46px;height:46px;display:flex;align-items:center;justify-content:center;font-size:17px;background:linear-gradient(180deg,color-mix(in srgb,var(--brand) 90%,#ffffff),var(--brand));color:var(--on-brand);border:none;border-radius:50%;opacity:0;pointer-events:none;transition:opacity .2s var(--ease-out),transform .2s var(--ease-out);z-index:950;cursor:pointer;box-shadow:var(--shadow-md)}.scroll-top.show{opacity:1;pointer-events:auto}.scroll-top:hover{transform:translateY(-3px)}@media (max-width:1024px){.hero-content,.contact-content{grid-template-columns:1fr}.image-wrapper{width:340px;height:340px}.projects-grid,.achievements-grid{grid-template-columns:repeat(2,1fr)}.about-content{grid-template-columns:280px 1fr;gap:44px}.about-image{max-width:280px}}@media (max-width:900px){.about-content{grid-template-columns:1fr;gap:40px}.about-image{max-width:320px}.soft-skills-grid{grid-template-columns:repeat(2,1fr)}}@media (max-width:768px){.hamburger{display:flex}.nav-menu{position:fixed;top:72px;left:-100%;width:100%;height:calc(100dvh - 72px);background:var(--surface);border-top:1px solid var(--line);overflow-y:auto;z-index:999;transition:left .28s var(--ease-out)}.nav-menu.active{left:0}.nav-list{flex-direction:column;padding:30px 24px;gap:20px}.hero-title{font-size:38px}.hero-subtitle{font-size:30px}.section-title{font-size:32px}.skills-grid,.projects-grid,.achievements-grid{grid-template-columns:1fr}.soft-skills-grid{grid-template-columns:repeat(2,1fr)}.footer-content{grid-template-columns:1fr}.about-content{grid-template-columns:1fr;gap:40px}.about-image{max-width:100%;margin:0 auto}.about-text h3{font-size:24px}.about-text p{font-size:16px;text-align:left}.about-stats{grid-template-columns:1fr}.contact-content{gap:32px}.info-card{padding:18px 16px;gap:14px}.info-card:hover{transform:none}.info-icon{width:46px;height:46px;font-size:19px}.contact-form{padding:24px 18px}.footer{padding-bottom:92px}.scroll-top{bottom:20px;right:16px;width:42px;height:42px;font-size:16px}}.home-section,.projects,.achievements,.blog,.contact{content-visibility:auto;contain-intrinsic-size:auto 420px}.skip-link{position:fixed;top:10px;left:12px;z-index:2000;padding:10px 18px;border-radius:999px;background:var(--brand);color:var(--on-brand);font-weight:700;font-size:14px;box-shadow:var(--shadow-md);transform:translateY(-160%);transition:transform .2s var(--ease-out)}.skip-link:focus{transform:translateY(0)}main:focus{outline:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
