class ContactForm{constructor(){this.form=document.getElementById("contact-form"),this.submitBtn=null,this.init()}init(){this.form&&(typeof emailjs>"u"?console.warn("EmailJS ch\u01B0a t\u1EA3i. Form s\u1EBD m\u1EDF mailto fallback."):emailjs.init(typeof CONFIG<"u"&&CONFIG.api?.emailjs?.publicKey||"oCLX80jQ7U-0e5Mgc"),this.submitBtn=this.form.querySelector('button[type="submit"]'),this.form.addEventListener("submit",e=>this.handleSubmit(e)))}async handleSubmit(e){if(e.preventDefault(),!this.validateForm())return;this.setLoading(!0);const i=typeof CONFIG<"u"&&CONFIG.api?.emailjs?.serviceId||"service_tbgvmpj",t=typeof CONFIG<"u"&&CONFIG.api?.emailjs?.templateId||"template_heik4ow";try{if(typeof emailjs>"u"){const n=this.form.querySelector("#name").value.trim(),s=this.form.querySelector("#email").value.trim(),o=this.form.querySelector("#subject").value.trim(),a=this.form.querySelector("#message").value.trim(),r=encodeURIComponent(`T\u1EEB: ${n} <${s}>

${a}`),c=typeof CONFIG<"u"&&CONFIG.info?.email||"nguyenthanhluan.270924@gmail.com";window.location.href=`mailto:${c}?subject=${encodeURIComponent(o)}&body=${r}`,this.showNotification("\u0110\xE3 m\u1EDF \u1EE9ng d\u1EE5ng email c\u1EE7a b\u1EA1n.","info");return}await emailjs.sendForm(i,t,this.form),this.showNotification("G\u1EEDi th\xE0nh c\xF4ng! T\xF4i s\u1EBD ph\u1EA3n h\u1ED3i s\u1EDBm nh\u1EA5t.","success"),this.form.reset()}catch(n){console.error("Email error:",n),this.showNotification("G\u1EEDi th\u1EA5t b\u1EA1i. Vui l\xF2ng th\u1EED l\u1EA1i ho\u1EB7c email tr\u1EF1c ti\u1EBFp.","error")}finally{this.setLoading(!1)}}validateForm(){const e=this.form.querySelector("#name").value.trim(),i=this.form.querySelector("#email").value.trim(),t=this.form.querySelector("#subject").value.trim(),n=this.form.querySelector("#message").value.trim();return!e||!i||!t||!n?(this.showNotification("Vui l\xF2ng \u0111i\u1EC1n \u0111\u1EA7y \u0111\u1EE7 th\xF4ng tin!","warning"),!1):/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(i)?!0:(this.showNotification("Email kh\xF4ng h\u1EE3p l\u1EC7!","warning"),!1)}setLoading(e){this.submitBtn&&(e?(this.submitBtn.disabled=!0,this.submitBtn.innerHTML='<i class="fas fa-spinner fa-spin"></i> \u0110ang g\u1EEDi...'):(this.submitBtn.disabled=!1,this.submitBtn.innerHTML='<i class="fas fa-paper-plane"></i> G\u1EEDi Tin Nh\u1EAFn'))}showNotification(e,i="info"){const t=document.createElement("div");t.className=`contact-notification ${i}`,t.innerHTML=`
            <i class="fas fa-${this.getIcon(i)}"></i>
            <span>${e}</span>
        `,document.body.appendChild(t),setTimeout(()=>t.classList.add("show"),10),setTimeout(()=>{t.classList.remove("show"),setTimeout(()=>t.remove(),300)},5e3)}getIcon(e){return{success:"check-circle",error:"exclamation-circle",warning:"exclamation-triangle",info:"info-circle"}[e]||"info-circle"}}document.readyState==="loading"?document.addEventListener("DOMContentLoaded",()=>{new ContactForm}):new ContactForm;
