            <span class="time-remaining">
                <i class="fas fa-clock"></i>
                <span class="time-text">T\xEDnh to\xE1n...</span>
            </span>
            <span class="progress-percentage">0%</span>
        `,document.body.appendChild(i),this.progressBar=this.progressContainer.querySelector(".reading-progress-bar"),this.timeEstimate=i.querySelector(".time-text"),this.progressPercentage=i.querySelector(".progress-percentage")}calculateReadingTime(){const i=this.articleBody.innerText||this.articleBody.textContent;this.totalWords=i.trim().split(/\s+/).length;const e=Math.ceil(this.totalWords/this.readingSpeed),t=e<60?`${e} ph\xFAt \u0111\u1ECDc`:`${Math.floor(e/60)}h ${e%60}m \u0111\u1ECDc`;this.timeEstimate.textContent=t,this.totalReadingMinutes=e}attachScrollListener(){let i=!1;window.addEventListener("scroll",()=>{i||(window.requestAnimationFrame(()=>{this.updateProgress(),i=!1}),i=!0)}),this.updateProgress()}updateProgress(){const i=window.innerHeight,e=document.documentElement.scrollHeight,t=window.pageYOffset||document.documentElement.scrollTop,o=e-i,r=o>0?t/o*100:100,n=Math.min(100,Math.max(0,r));if(this.progressBar.style.transform=`scaleX(${n/100})`,this.progressPercentage&&(this.progressPercentage.textContent=`${Math.round(n)}%`),this.totalReadingMinutes){const s=100-n,a=Math.ceil(this.totalReadingMinutes*s/100);a>0?this.timeEstimate.textContent=`C\xF2n ${a} ph\xFAt`:this.timeEstimate.textContent="Ho\xE0n th\xE0nh!"}t>100?this.progressContainer.classList.add("visible"):this.progressContainer.classList.remove("visible")}markCurrentAsRead(){const i=this.getArticleId();if(i&&!this.readArticles.includes(i)){let e=!1,t=!1;const o=()=>{e||t||(t=!0,window.requestAnimationFrame(()=>{if(t=!1,e)return;const r=document.documentElement.scrollHeight-window.innerHeight;(r>0?window.pageYOffset/r*100:0)>50&&(this.readArticles.push(i),this.saveReadArticles(),e=!0,window.removeEventListener("scroll",o),this.showNotification("\u0110\xE3 \u0111\xE1nh d\u1EA5u b\xE0i vi\u1EBFt l\xE0 \u0111\xE3 \u0111\u1ECDc","success"))}))};window.addEventListener("scroll",o,{passive:!0})}}getArticleId(){const e=new URLSearchParams(window.location.search).get("id");if(e)return e;const t=this.articleBody?.getAttribute("data-article-id");if(t)return t;const o=document.querySelector("h1")?.textContent;return o?this.slugify(o):null}slugify(i){return i.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-+|-+$/g,"")}loadReadArticles(){try{const i=localStorage.getItem("readArticles"),e=i?JSON.parse(i):[];return Array.isArray(e)?e:[]}catch{return[]}}saveReadArticles(){localStorage.setItem("readArticles",JSON.stringify(this.readArticles))}markReadArticlesInList(){document.querySelectorAll(".blog-card").forEach(e=>{const t=e.querySelector(".blog-link"),o=e.querySelector("h3")?.textContent;if(o){const r=this.slugify(o);if(this.readArticles.includes(r)&&(e.classList.add("read-article"),!e.querySelector(".read-indicator"))){const n=document.createElement("div");n.className="read-indicator",n.innerHTML='<i class="fas fa-check-circle"></i> \u0110\xE3 \u0111\u1ECDc',e.querySelector(".blog-content").prepend(n)}}})}showNotification(i,e="info"){const t=document.createElement("div");t.className=`blog-notification ${e}`,t.innerHTML=`
