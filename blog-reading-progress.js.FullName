class BlogReadingProgress{constructor(){this.progressBar=null,this.progressContainer=null,this.timeEstimate=null,this.articleBody=null,this.readingSpeed=200,this.totalWords=0,this.readArticles=this.loadReadArticles(),this.init()}init(){if(this.articleBody=document.querySelector(".blog-post-content, .post-content, article.blog-post"),!this.articleBody){this.markReadArticlesInList(),this.initBlogFilter();return}this.createProgressBar(),this.calculateReadingTime(),this.attachScrollListener(),this.markCurrentAsRead(),this.initShareButtons(),this.initCodeCopyButtons()}initBlogFilter(){const i=document.querySelectorAll(".blog-filter-btn"),e=document.querySelectorAll(".blog-card[data-category]");!i.length||!e.length||i.forEach(t=>{t.addEventListener("click",()=>{i.forEach(r=>{r.classList.remove("active"),r.setAttribute("aria-pressed","false")}),t.classList.add("active"),t.setAttribute("aria-pressed","true");const o=t.getAttribute("data-filter");e.forEach(r=>{const n=r.getAttribute("data-category"),s=o==="all"||n===o;r.style.display=s?"":"none"})})})}initCodeCopyButtons(){this.articleBody.querySelectorAll("pre").forEach(e=>{if(e.querySelector(".copy-code-btn"))return;e.classList.add("has-copy-btn");const t=document.createElement("button");t.type="button",t.className="copy-code-btn",t.innerHTML='<i class="far fa-copy"></i> Sao ch\xE9p',t.addEventListener("click",async()=>{const o=e.querySelector("code"),r=o?o.innerText:e.innerText;try{await navigator.clipboard.writeText(r),t.innerHTML='<i class="fas fa-check"></i> \u0110\xE3 ch\xE9p',t.classList.add("copied"),setTimeout(()=>{t.innerHTML='<i class="far fa-copy"></i> Sao ch\xE9p',t.classList.remove("copied")},1800)}catch{this.showNotification("Kh\xF4ng th\u1EC3 sao ch\xE9p \u0111o\u1EA1n m\xE3.","info")}}),e.appendChild(t)})}initShareButtons(){const i=document.querySelectorAll(".share-btn");if(!i.length)return;const e=window.location.href,t=document.querySelector("h1")?.textContent?.trim()||document.title;i.forEach(o=>{o.addEv