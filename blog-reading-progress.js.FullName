        `,document.body.appendChild(t),setTimeout(()=>t.classList.add("show"),100),setTimeout(()=>{t.classList.remove("show"),setTimeout(()=>t.remove(),300)},3e3)}}const progressStyles=document.createElement("style");progressStyles.textContent=`
    .reading-progress-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: var(--line, #dbeafe);
        z-index: 1005;
        opacity: 0;
        transform: translateY(-100%);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .reading-progress-container.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .reading-progress-bar {
        height: 100%;
        width: 100%;
        background: linear-gradient(90deg, var(--brand, #0284c7), var(--accent, #38bdf8));
        transform: scaleX(0);
        transform-origin: left center;
        will-change: transform;
    }

    .reading-stats {
        position: fixed;
        bottom: 24px;
        left: 24px;
        display: flex;
        gap: 12px;
        align-items: center;
        background: var(--surface, #ffffff);
        padding: 9px 16px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-strong, #0b1f33);
        box-shadow: var(--shadow-md, 0 8px 24px rgba(14, 116, 184, 0.12));
        border: 1px solid var(--line, #dbeafe);
        z-index: 940;
    }

    .time-remaining {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--brand, #0284c7);
    }

    .time-remaining i {
        font-size: 14px;
    }

    .progress-percentage {
        color: var(--text-strong, #0b1f33);
        font-weight: 700;
        min-width: 34px;
        text-align: right;
    }

    /* Read article indicator */
    .blog-card.read-article {
        opacity: 0.94;
        position: relative;
    }

    .read-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: var(--brand-soft, #e0f2fe);
        border: 1px solid color-mix(in srgb, var(--brand, #0284c7) 24%, transparent);
        border-radius: 20px;
        color: var(--brand-hover, #0369a1);
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 10px;
        width: fit-content;
    }

    .read-indicator i {
        font-size: 12px;
    }

    /* Code block copy button */
    .main-content pre.has-copy-btn {
        position: relative;
        padding-top: 44px;
    }

    .copy-code-btn {
        position: absolute;
        top: 10px;
        right: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        border: 1px solid rgba(125, 211, 252, 0.28);
        background: rgba(15, 42, 72, 0.85);
        color: #bae6fd;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    }

    .copy-code-btn:hover {
        background: #0284c7;
        border-color: #38bdf8;
        color: #ffffff;
    }

    .copy-code-btn.copied {
        background: #059669;
        border-color: #34d399;
        color: #ffffff;
    }

    /* Notification */
    .blog-notification {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%) translateY(100px);
        background: var(--surface, #ffffff);
        color: var(--text-strong, #0b1f33);
        padding: 12px 20px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 600;
        z-index: 10000;
        box-shadow: var(--shadow-md, 0 12px 32px rgba(14, 116, 184, 0.15));
        border: 1px solid var(--line, #dbeafe);
        opacity: 0;
        transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .blog-notification.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    .blog-notification.success {
        border-color: rgba(12, 122, 84, 0.35);
    }

    .blog-notification i {
        color: #0c7a54;
        font-size: 18px;
    }

    /* Mobile responsive */
    @media (max-width: 768px) {
        .reading-stats {
            bottom: 20px;
            left: 16px;
            padding: 7px 12px;
            gap: 8px;
            font-size: 11px;
        }

        .blog-notification {
            bottom: 20px;
            max-width: 90%;
            padding: 10px 16px;
            font-size: 13px;
        }
    }
`,document.head.appendChild(progressStyles),document.readyState==="loading"?document.addEventListener("DOMContentLoaded",()=>{new BlogReadingProgress}):new BlogReadingProgress;
