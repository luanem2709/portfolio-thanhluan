class ComponentLoader{constructor(){this.inPages=window.location.pathname.includes("/pages/"),this.init()}async init(){await this.loadNavbar(),await this.loadFooter(),this.fixInternalLinks(),this.setActiveNavLink(),this.initMobileMenu(),this.initNavbarScroll(),this.initScrollTop()}async loadNavbar(){try{const t=await fetch(this.componentPath("navbar.html"));if(!t.ok)throw new Error(t.statusText);document.body.insertAdjacentHTML("afterbegin",await t.text())}catch(t){console.error("Error loading navbar:",t)}}async loadFooter(){try{const t=await fetch(this.componentPath("footer.html"));if(!t.ok)throw new Error(t.statusText);document.body.insertAdjacentHTML("beforeend",await t.text())}catch(t){console.error("Error loading footer:",t)}}componentPath(t){return this.inPages?`../components/${t}`:`components/${t}`}fixInternalLinks(){this.inPages&&document.querySelectorAll(".navbar a[href], .footer a[href]").forEach(t=>{const e=t.getAttribute("href");e&&(/^(https?:|mailto:|tel:|#)/i.test(e)||e.startsWith("../")||t.setAttribute("href","../"+e))})}setActiveNavLink(){const t=window.location.pathname.split("/").pop()||"index.html";let e="index.html";t.startsWith("blog")?e="blog.html":t&&t!==""&&t!=="index.html"&&(e=t),document.querySelectorAll(".nav-link").forEach(n=>{n.classList.remove("active"),n.removeAttribute("aria-current"),(n.getAttribute("href")||"").split("/").pop()===e&&(n.classList.add("active"),n.setAttribute("aria-current","page"))})}initMobileMenu(){const t=document.getElementById("hamburger"),e=document.getElementById("nav-menu");if(!t||!e)return;const n=()=>{t.classList.remove("active"),e.classList.remove("active"),t.setAttribute("aria-expanded","false")};t.addEventListener("click",()=>{const r=e.classList.toggle("active");t.classList.toggle("active",r),t.setAttribute("aria-expanded",String(r))}),document.querySelectorAll(".nav-link").forEach(r=>{r.addEventListener("click",n)}),document.addEventListener("keydown",r=>{r.key==="Escape"&&e.classList.contains("active")&&n()})}initNavbarScroll(){const t=document.getElementById("navbar");if(!t)return;let e=!1;const n=()=>{e||(e=!0,requestAnimationFrame(()=>{t.classList.toggle("scrolled",window.scrollY>50),e=!1}))};requestAnimationFrame(()=>t.classList.toggle("scrolled",window.scrollY>50)),window.addEventListener("scroll",n,{passive:!0})}initScrollTop(){const t=document.getElementById("scroll-top");if(!t)return;let e=!1;const n=()=>{e||(e=!0,requestAnimationFrame(()=>{t.classList.toggle("show",window.scrollY>300),e=!1}))};window.addEventListener("scroll",n,{passive:!0}),t.addEventListener("click",()=>{window.scrollTo({top:0,behavior:"smooth"})})}}document.readyState==="loading"?document.addEventListener("DOMContentLoaded",()=>new ComponentLoader):new ComponentLoader;
