.blog{padding:100px 0;background:transparent;position:relative;overflow:hidden;z-index:2}.blog:before{content:none}.blog-filter{display:flex;justify-content:center;gap:12px;margin:36px 0 8px;flex-wrap:wrap}.blog-filter-btn{padding:10px 22px;background:var(--surface, #ffffff);border:1px solid var(--line-strong, #bfdbfe);border-radius:999px;color:var(--muted-strong, #37516a);font-size:14px;font-weight:600;cursor:pointer;box-shadow:var(--shadow-xs);transition:transform .2s var(--ease-out),background .2s var(--ease-out),border-color .2s var(--ease-out),color .2s var(--ease-out),box-shadow .2s var(--ease-out)}.blog-filter-btn:hover{background:var(--brand-soft, #e0f2fe);border-color:var(--brand, #0284c7);color:var(--brand-hover, #0369a1);transform:translateY(-2px)}.blog-filter-btn.active{background:linear-gradient(135deg,var(--brand, #0284c7),var(--accent, #38bdf8));border-color:var(--brand, #0284c7);color:var(--on-brand, #ffffff);box-shadow:0 6px 18px color-mix(in srgb,var(--brand, #0284c7) 24%,transparent)}.blog-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:28px;margin-top:38px}.blog-card{background:var(--surface, #ffffff);border-radius:20px;overflow:hidden;border:1px solid color-mix(in srgb,var(--line, #dbeafe) 92%,transparent);box-shadow:var(--shadow-sm);transition:transform .24s var(--ease-out),border-color .24s var(--ease-out),box-shadow .24s var(--ease-out);position:relative;z-index:5;display:flex;flex-direction:column}.blog-card:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,color-mix(in srgb,var(--brand, #0284c7) 4%,transparent),transparent 60%);opacity:0;transition:opacity .24s var(--ease-out);pointer-events:none}.blog-card:hover{transform:translateY(-5px);border-color:color-mix(in srgb,var(--brand, #0284c7) 34%,var(--line, #dbeafe));box-shadow:var(--shadow-md)}.blog-card:hover:before{opacity:1}.blog-image{position:relative;height:198px;overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--surface-muted, #eef6ff);border-bottom:1px solid var(--line, #dbeafe)}.blog-image:before{content:none}.blog-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .35s var(--ease-out)}.blog-card:hover .blog-image img{transform:scale(1.05)}.blog-category{position:absolute;top:14px;right:14px;background:color-mix(in srgb,var(--surface, #ffffff) 94%,transparent);color:var(--brand-hover, #0369a1);border:1px solid color-mix(in srgb,var(--brand, #0284c7) 24%,var(--line, #dbeafe));padding:5px 14px;border-radius:999px;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;z-index:2}.blog-content{padding:24px;flex:1;display:flex;flex-direction:column}.blog-meta{display:flex;flex-wrap:wrap;gap:8px 16px;margin-bottom:12px;font-size:13px;color:var(--muted, #5a728a)}.blog-meta span{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}.blog-meta i{color:var(--brand, #0284c7)}.blog-content h3{font-size:19px;color:var(--text-strong, #0b1f33);margin-bottom:10px;line-height:1.42;font-weight:700;transition:color .2s var(--ease-out)}.blog-card:hover .blog-content h3{color:var(--brand, #0284c7)}.blog-content p{color:var(--muted, #5a728a);font-size:14.5px;line-height:1.68;margin-bottom:18px;flex:1}.blog-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}.blog-tags .tag{background:var(--brand-soft, #e0f2fe);color:var(--brand-hover, #0369a1);padding:5px 12px;border-radius:999px;font-size:12px;font-weight:600;border:1px solid color-mix(in srgb,var(--brand, #0284c7) 22%,transparent);transition:background .2s var(--ease-out),color .2s var(--ease-out);white-space:nowrap}.blog-tags .tag:hover{background:var(--brand-soft-strong, #bae6fd)}.blog-link{display:inline-flex;align-items:center;gap:8px;margin-top:auto;color:var(--brand, #0284c7);font-weight:700;font-size:14px;text-decoration:none;transition:color .2s var(--ease-out),gap .2s var(--ease-out)}.blog-link i{transition:transform .2s var(--ease-out)}.blog-link:hover{color:var(--brand-hover, #0369a1);gap:11px}.blog-link:hover i{transform:translate(5px)}@media (max-width: 768px){.blog-grid{grid-template-columns:1fr;gap:20px}.blog-image{height:176px}.blog-content h3{font-size:18px}}
