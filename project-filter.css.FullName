section{position:relative;z-index:2;padding:100px 0}.projects-filter{display:flex;justify-content:center;gap:15px;margin:40px 0;flex-wrap:wrap;position:relative;z-index:20}.filter-btn{padding:11px 24px;background:var(--surface);border:1px solid var(--line-strong);border-radius:999px;color:var(--muted-strong);font-size:14px;font-weight:600;cursor:pointer!important;transition:all .22s var(--ease-out);position:relative;z-index:20;box-shadow:var(--shadow-xs);pointer-events:auto!important;user-select:none}.filter-btn:hover{background:var(--brand-soft);border-color:var(--brand);color:var(--brand);transform:translateY(-2px);box-shadow:var(--shadow-sm)}.filter-btn.active{background:linear-gradient(180deg,color-mix(in srgb,var(--brand) 90%,#ffffff),var(--brand));border-color:var(--brand);color:var(--on-brand);box-shadow:0 6px 18px color-mix(in srgb,var(--brand) 22%,transparent)}.filter-btn.active:hover{transform:translateY(-2px);box-shadow:0 8px 22px color-mix(in srgb,var(--brand) 28%,transparent)}.projects-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:30px;margin-top:40px;position:relative;z-index:15}.project-card{position:relative;z-index:15;opacity:1;transform:scale(1);transition:all .3s ease}@media (max-width: 768px){.projects-filter{gap:10px}.filter-btn{padding:10px 20px;font-size:13px}.projects-grid{grid-template-columns:1fr;gap:20px}}
