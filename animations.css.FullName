@keyframes fadeInUp{0%{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}@keyframes floatSoft{0%,to{transform:translateY(0)}50%{transform:translateY(-6px)}}@keyframes ringOrbit{0%{transform:rotate(0)}to{transform:rotate(360deg)}}@keyframes statusPulse{0%{transform:scale(1);opacity:.7}70%,to{transform:scale(2.2);opacity:0}}@keyframes scrollHint{0%,to{transform:translateY(0)}50%{transform:translateY(4px)}}.hero-content>*{animation:fadeInUp .45s var(--ease-out) backwards}.hero-text .greeting{animation-delay:.04s}.hero-text .hero-title{animation-delay:.08s}.hero-text .typing-container{animation-delay:.12s}.hero-text .hero-description{animation-delay:.16s}.hero-text .hero-buttons{animation-delay:.2s}.hero-text .social-links{animation-delay:.24s}.image-wrapper:before{animation:ringOrbit 38s linear infinite}.scroll-down a i{animation:scrollHint 2.4s ease-in-out infinite}.project-card,.blog-card,.achievement-card,.info-card,.stat-item,.soft-skill-item,.home-service,.home-stat,.home-skill-group{transition:transform .24s var(--ease-out),border-color .24s var(--ease-out),box-shadow .24s var(--ease-out);position:relative}.info-card:hover i,.home-service:hover .home-service-icon,.home-stat:hover i{transform:translateY(-2px) scale(1.06)}.home-service-icon,.home-stat i,.info-card i{transition:transform .24s var(--ease-out),background .24s var(--ease-out),color .24s var(--ease-out)}.tag{transition:transform .18s var(--ease-out),background .18s var(--ease-out),border-color .18s var(--ease-out)}.tag:hover{transform:translateY(-1px)}.achievement-badge{transition:transform .25s var(--ease-out)}.achievement-card:hover .achievement-badge{transform:scale(1.08)}@media (prefers-reduced-motion: reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
