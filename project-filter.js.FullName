class ProjectFilter{constructor(){this.filterBtns=document.querySelectorAll(".filter-btn"),this.projectCards=document.querySelectorAll(".project-card"),this.timers=new WeakMap,this.init()}init(){this.filterBtns.length===0||this.projectCards.length===0||this.filterBtns.forEach(e=>{e.addEventListener("click",()=>this.filterProjects(e))})}clearCardTimer(e){const s=this.timers.get(e);s&&(clearTimeout(s),this.timers.delete(e))}filterProjects(e){this.filterBtns.forEach(t=>{t.classList.remove("active"),t.setAttribute("aria-pressed","false")}),e.classList.add("active"),e.setAttribute("aria-pressed","true");const s=e.getAttribute("data-filter");this.projectCards.forEach(t=>{this.clearCardTimer(t);const i=t.getAttribute("data-category");if(s==="all"||i===s){t.classList.add("fade-in-visible","reveal-active"),t.style.display="",t.style.transition="opacity 0.25s ease, transform 0.25s ease",t.style.opacity="0",t.style.transform="scale(0.97)";const r=setTimeout(()=>{t.style.opacity="1",t.style.transform="scale(1)",this.timers.delete(t)},16);this.timers.set(t,r)}else t.style.display="none",t.style.opacity="0",t.style.transform="scale(0.97)"})}}document.readyState==="loading"?document.addEventListener("DOMContentLoaded",()=>{new ProjectFilter}):new ProjectFilter;
