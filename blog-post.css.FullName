*{margin:0;padding:0;box-sizing:border-box}body{font-family:Be Vietnam Pro,Sora,IBM Plex Sans,system-ui,sans-serif;background:radial-gradient(circle at 50% -12%,color-mix(in srgb,var(--brand-soft, #e0f2fe) 75%,transparent),transparent 34rem),var(--background, #f5f9ff);color:var(--text, #1e354d);line-height:1.65;position:relative;overflow-x:clip}.navbar{padding:16px 0}.container{max-width:1200px;margin:0 auto;padding:0 20px}.blog-post{padding-top:80px;position:relative;z-index:1}.post-header{background:linear-gradient(120deg,var(--surface, #ffffff) 0%,var(--surface, #ffffff) 68%,color-mix(in srgb,var(--brand-soft, #e0f2fe) 68%,var(--surface, #ffffff)) 100%);padding:56px 0 40px;position:relative;border-bottom:1px solid var(--line, #dbeafe)}.post-header:before{content:none}.breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:20px;font-size:14px;color:var(--muted, #5a728a)}.breadcrumb a{color:var(--brand, #0284c7);font-weight:600;transition:color .2s}.breadcrumb a:hover{color:var(--brand-hover, #0369a1)}.breadcrumb span{color:var(--muted, #5a728a)}.post-category{display:inline-block;background:var(--brand-soft, #e0f2fe);color:var(--brand-hover, #0369a1);border:1px solid color-mix(in srgb,var(--brand, #0284c7) 24%,transparent);padding:6px 16px;border-radius:999px;font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:18px}.post-header h1{font-size:clamp(28px,3.6vw,40px);font-weight:800;color:var(--text-strong, #0b1f33);margin-bottom:28px;line-height:1.24;max-width:900px}.post-meta{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}.author-info{display:flex;align-items:center;gap:15px}.author-info img{width:50px;height:50px;object-fit:cover;border-radius:50%;border:2px solid var(--brand, #0284c7)}.author-name{display:block;color:var(--text-strong, #0b1f33);font-weight:700;font-size:16px}.post-date{display:block;color:var(--muted, #5a728a);font-size:14px}.post-stats{display:flex;gap:20px;color:var(--muted-strong, #37516a);font-size:14px}.post-stats span{display:flex;align-items:center;gap:6px}.post-stats i{color:var(--brand, #0284c7)}.post-featured-image{max-width:1200px;margin:28px auto 40px;padding:0 20px}.post-cover-frame{margin:0;border-radius:22px;overflow:hidden;border:1px solid var(--line, #dbeafe);background:var(--surface, #ffffff);box-shadow:var(--shadow-md, 0 18px 44px rgba(14, 116, 184, .12))}.post-cover-frame img{width:100%;max-height:440px;object-fit:cover;object-position:center;display:block}.post-cover-frame--screenshot{background:linear-gradient(135deg,var(--surface-muted, #eef6ff) 0%,var(--brand-soft, #e0f2fe) 100%);padding:20px;display:flex;align-items:center;justify-content:center}.post-cover-frame--screenshot img{width:min(100%,760px);height:auto;max-height:380px;object-fit:contain;border-radius:14px;border:1px solid var(--line, #dbeafe);box-shadow:var(--shadow-md, 0 14px 32px rgba(14, 116, 184, .14))}.article-figure{margin:28px 0;background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-radius:16px;overflow:hidden;box-shadow:var(--shadow-sm)}.article-figure img{width:100%;max-height:430px;object-fit:cover;object-position:center;display:block}.article-figure--contain img{object-fit:contain;padding:16px;background:var(--surface, #ffffff);max-height:380px}.article-figure--compact{max-width:500px;margin:28px auto}.article-figure--compact img{object-fit:contain;padding:18px;background:var(--surface-muted, #eef6ff);max-height:240px}.article-figure figcaption{padding:12px 18px;font-size:13.5px;color:var(--muted, #5a728a);background:var(--surface-muted, #eef6ff);border-top:1px solid var(--line, #dbeafe);text-align:center;line-height:1.5}.post-content{padding:20px 0 96px;background:transparent}.content-wrapper{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:48px;max-width:1200px;margin:0 auto;padding:0 20px}.main-content{color:var(--text, #1e354d);font-size:16.5px;line-height:1.82}.lead{font-size:18px;color:var(--text-strong, #0b1f33);line-height:1.74;margin-bottom:34px;padding:22px 26px;background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-left:4px solid var(--brand, #0284c7);border-radius:14px;box-shadow:var(--shadow-xs)}.main-content h2{font-size:27px;color:var(--text-strong, #0b1f33);font-weight:800;margin:44px 0 18px;padding-bottom:12px;border-bottom:1px solid var(--line, #dbeafe)}.main-content h3{font-size:20.5px;color:var(--brand-hover, #0369a1);font-weight:700;margin:30px 0 14px}.main-content h4{font-size:17.5px;color:var(--brand, #0284c7);font-weight:700;margin:20px 0 10px}.main-content p{margin-bottom:18px}.main-content ul,.main-content ol{margin:18px 0 22px;padding-left:26px}.main-content li{margin-bottom:10px;line-height:1.72}.main-content strong{color:var(--text-strong, #0b1f33);font-weight:700}.main-content em{color:var(--brand-hover, #0369a1)}.main-content a{color:var(--brand, #0284c7);text-decoration:underline;text-underline-offset:3px;transition:color .2s}.main-content a:hover{color:var(--brand-hover, #0369a1)}.main-content blockquote{margin:26px 0;padding:18px 24px;background:var(--surface-muted, #eef6ff);border-left:4px solid var(--brand, #0284c7);border-radius:0 14px 14px 0;color:var(--text-strong, #0b1f33);font-style:italic}.main-content blockquote p:last-child{margin-bottom:0}.main-content pre{background:#0b1b2e;border:1px solid #1e3b5c;border-radius:14px;padding:20px 22px;overflow-x:auto;margin:24px 0;color:#e6f1fc;box-shadow:var(--shadow-sm)}.main-content code{font-family:JetBrains Mono,Fira Code,Cascadia Code,Consolas,monospace;font-size:14px;color:#7dd3fc;line-height:1.65}.main-content p code,.main-content li code{background:var(--surface-strong, #e0f0fe);color:var(--brand-hover, #0369a1);padding:2px 7px;border-radius:6px;font-size:.9em}.info-box{background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-left:4px solid var(--brand, #0284c7);border-radius:14px;padding:20px 24px;margin:26px 0;display:flex;gap:15px;align-items:flex-start;box-shadow:var(--shadow-xs)}.info-box i{color:var(--brand, #0284c7);font-size:20px;margin-top:3px;flex-shrink:0}.info-box p{margin:0}.highlight-box{background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-left:4px solid var(--brand, #0284c7);border-radius:14px;padding:22px 24px;margin:24px 0;box-shadow:var(--shadow-xs)}.highlight-box h3{margin-top:0}.highlight-box p{margin:8px 0 12px;color:var(--text, #1e354d)}.highlight-box p:last-child,.highlight-box ul:last-child{margin-bottom:0}.highlight-box strong{color:var(--brand-hover, #0369a1);font-weight:700}.code-block{background:#0b1b2e;border:1px solid #1e3b5c;border-radius:14px;padding:22px 24px;margin:24px 0;font-family:JetBrains Mono,Fira Code,Consolas,monospace;color:#e6f1fc}.comparison-table{background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-radius:16px;padding:26px;margin:26px 0;box-shadow:var(--shadow-sm)}.comparison-table h3{color:var(--text-strong, #0b1f33);font-size:18px;margin-top:14px;margin-bottom:10px}.comparison-table h3:first-child{margin-top:0}.comparison-table ul{margin-top:8px}.tips-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin:26px 0}.tip-card{background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-radius:14px;padding:22px;box-shadow:var(--shadow-xs);transition:transform .22s var(--ease-out),border-color .22s var(--ease-out),box-shadow .22s var(--ease-out)}.tip-card:hover{border-color:color-mix(in srgb,var(--brand, #0284c7) 34%,var(--line, #dbeafe));box-shadow:var(--shadow-sm);transform:translateY(-3px)}.tip-card i{font-size:24px;color:var(--brand, #0284c7);margin-bottom:10px}.tip-card h4{color:var(--text-strong, #0b1f33);margin:6px 0 8px}.tip-card p{font-size:14.5px;color:var(--muted, #5a728a);margin:0}.signature{font-style:italic;color:var(--brand-hover, #0369a1);font-weight:600;font-size:16px;margin-top:32px}.post-tags{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin:40px 0 26px;padding-top:24px;border-top:1px solid var(--line, #dbeafe)}.post-tags .tag,.tag-cloud .tag{white-space:nowrap}.post-share{margin-top:28px;padding:24px 26px;background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-radius:16px;box-shadow:var(--shadow-sm)}.post-share h3{color:var(--text-strong, #0b1f33);margin-bottom:14px}.share-buttons{display:flex;flex-wrap:wrap;gap:12px}.share-btn{width:44px;height:44px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:#fff!important;text-decoration:none!important;transition:transform .22s var(--ease-out),box-shadow .22s var(--ease-out)}.share-btn.facebook{background:#1877f2}.share-btn.twitter{background:#0ea5e9}.share-btn.linkedin{background:#0284c7}.share-btn.copy{background:#334155}.share-btn:hover{transform:translateY(-3px);box-shadow:0 10px 20px #0e74b83d;color:#fff!important}.sidebar,.post-sidebar{position:sticky;top:100px;height:fit-content}.sidebar-card{background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-radius:18px;padding:24px;margin-bottom:22px;box-shadow:var(--shadow-sm)}.sidebar-card h3{color:var(--text-strong, #0b1f33);font-size:17.5px;margin-bottom:16px}.author-card{background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-radius:18px;padding:26px;text-align:center;margin-bottom:22px;box-shadow:var(--shadow-sm)}.author-card img{width:92px;height:92px;object-fit:cover;border-radius:50%;border:3px solid var(--brand, #0284c7);margin:0 auto 16px}.author-card h3{color:var(--text-strong, #0b1f33);font-size:18.5px;margin-bottom:8px}.author-card p{color:var(--muted, #5a728a);font-size:14px;line-height:1.6;margin-bottom:18px}.author-card .social-links,.author-card .author-social{display:flex;justify-content:center;gap:10px}.author-card .social-links a,.author-card .author-social a{width:38px;height:38px;background:var(--brand-soft, #e0f2fe);border:1px solid color-mix(in srgb,var(--brand, #0284c7) 22%,transparent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--brand, #0284c7);transition:background .2s var(--ease-out),color .2s var(--ease-out),transform .2s var(--ease-out)}.author-card .social-links a:hover,.author-card .author-social a:hover{background:var(--brand, #0284c7);color:var(--on-brand, #ffffff);transform:translateY(-2px)}.related-posts{background:var(--surface, #ffffff);border:1px solid var(--line, #dbeafe);border-radius:18px;padding:24px;box-shadow:var(--shadow-sm)}.sidebar-card .related-posts{background:transparent;border:none;box-shadow:none;padding:0}.related-posts h3{color:var(--text-strong, #0b1f33);font-size:17.5px;margin-bottom:16px}.related-post{display:flex;align-items:center;gap:14px;padding:10px;border-radius:12px;transition:background .2s var(--ease-out),transform .2s var(--ease-out);margin-bottom:10px;text-decoration:none}.related-post:last-child{margin-bottom:0}.related-post:hover{background:var(--brand-soft, #e0f2fe);transform:translate(3px)}.related-info span{font-size:12px;color:var(--muted, #5a728a)}.tag-cloud{display:flex;flex-wrap:wrap;gap:8px}.related-thumb{width:74px;height:54px;border-radius:10px;object-fit:cover;object-position:center;flex-shrink:0;border:1px solid var(--line, #dbeafe);background:var(--surface-muted, #eef6ff)}.related-gradient{width:68px;height:68px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:linear-gradient(135deg,#0284c7,#38bdf8)}.related-gradient.web-bg{background:linear-gradient(135deg,#075985,#0ea5e9)}.related-gradient.code-bg{background:linear-gradient(135deg,#0284c7,#38bdf8)}.related-gradient.community-bg{background:linear-gradient(135deg,#0ea5e9,#7dd3fc)}.related-gradient.database-bg{background:linear-gradient(135deg,#1d4ed8,#38bdf8)}.related-gradient.game-bg{background:linear-gradient(135deg,#0369a1,#60a5fa)}.related-gradient.marketing-bg,.related-gradient.content-bg{background:linear-gradient(135deg,#0c4a6e,#0284c7)}.related-gradient i{font-size:26px;color:#fff}.related-post h4{color:var(--text-strong, #0b1f33);font-size:14px;line-height:1.48;font-weight:600}@media (max-width: 1024px){.content-wrapper{grid-template-columns:1fr}.sidebar,.post-sidebar{position:static}.tips-grid{grid-template-columns:1fr}}@media (max-width: 768px){.post-header h1{font-size:26px}.post-featured-gradient{height:190px}.post-featured-gradient i{width:82px;height:82px;font-size:38px}.main-content{font-size:16px}.main-content h2{font-size:23px}.main-content h3{font-size:19px}.post-featured-image{margin:22px auto 30px}.post-cover-frame img{max-height:240px}.post-cover-frame--screenshot{padding:12px}}
