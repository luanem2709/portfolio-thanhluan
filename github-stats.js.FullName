class GitHubStats{constructor(){this.username=CONFIG.info.github,this.apiUrl=CONFIG.api.github,this.stats=null,this.refreshInterval=null,this.animationTimers={},this.init()}async init(){await this.fetchStats(),this.createWidget(),this.updateWidget(),this.refreshInterval&&clearInterval(this.refreshInterval),this.refreshInterval=setInterval(async()=>{await this.fetchStats(),this.updateWidget()},3e5)}async fetchStats(){try{const t=await fetch(this.apiUrl);if(t.status===403)throw new Error("GitHub API rate limit exceeded (60 req/h ch\u01B0a x\xE1c th\u1EF1c)");if(!t.ok)throw new Error(`GitHub user API l\u1ED7i: ${t.status}`);const e=await t.json(),s=await fetch(`${this.apiUrl}/repos?sort=updated&per_page=100`);if(!s.ok)throw new Error(`GitHub repos API l\u1ED7i: ${s.status}`);const a=await s.json();if(!Array.isArray(a))throw new Error("GitHub repos API tr\u1EA3 v\u1EC1 d\u1EEF li\u1EC7u kh\xF4ng h\u1EE3p l\u1EC7");const o=a.reduce((i,l)=>i+l.stargazers_count,0),d=a.reduce((i,l)=>i+l.forks_count,0),n={};a.forEach(i=>{i.language&&(n[i.language]=(n[i.language]||0)+1)});const r=Object.entries(n).sort((i,l)=>l[1]-i[1]).slice(0,3).map(([i])=>i);this.stats={repos:e.public_repos,followers:e.followers,following:e.following,stars:o,forks:d,topLanguages:r,latestRepo:a[0],avatar:e.avatar_url,bio:e.bio}}catch(t){console.warn("GitHub stats fallback:",t.message),this.stats={repos:22,followers:2,following:5,stars:3,forks:0,topLanguages:["HTML","TypeScript","C#"],latestRepo:{name:"portfolio-thanhluan",updated_at:new Date().toISOString()}}}}createWidget(){const t=document.createElement("div");t.className="github-stats-widget collapsed",t.id="github-stats",t.innerHTML=`
            <div class="github-widget-header" role="button" tabindex="0" aria-expanded="false" aria-label="GitHub Stats - m\u1EDF ho\u1EB7c thu g\u1ECDn th\u1ED1ng k\xEA">
                <i class="fab fa-github"></i>
                <span>GitHub Stats</span>
                <span class="widget-toggle" aria-hidden="true">
                    <i class="fas fa-chevron-down"></i>
                </span>
            </div>
            <div class="github-widget-content">
                <div class="github-stat-grid">
                    <div class="github-stat-item">
                        <i class="fas fa-code-branch"></i>
                        <div class="stat-value" id="gh-repos">--</div>
                        <div class="stat-label">Repositories</div>
                    </div>
                    <div class="github-stat-item">
                        <i class="fas fa-star"></i>
                        <div class="stat-value" id="gh-stars">--</div>
                        <div class="stat-label">Stars</div>
                    </div>
                    <div class="github-stat-item">
                        <i class="fas fa-users"></i>
                        <div class="stat-value" id="gh-followers">--</div>
                        <div class="stat-label">Followers</div>
                    </div>
                    <div class="github-stat-item github-stat-item--langs">
                        <i class="fas fa-code"></i>
                        <div class="stat-value" id="gh-languages">--</div>
                        <div class="stat-label">Top Languages</div>
                    </div>
                </div>
                <div class="github-latest-repo">
                    <div class="repo-label">Latest Update:</div>
                    <div class="repo-name" id="gh-latest-repo">--</div>
                    <div class="repo-time" id="gh-latest-time">--</div>
                </div>
                <a href="https://github.com/${this.username}" target="_blank" rel="noopener noreferrer" class="github-profile-link">
                    <i class="fab fa-github"></i> View Full Profile
                </a>
            </div>
        `,document.body.appendChild(t);const e=t.querySelector(".github-widget-header"),s=()=>{const a=t.classList.toggle("collapsed");e.setAttribute("aria-expanded",String(!a))};e.addEventListener("click",s),e.addEventListener("keydown",a=>{(a.key==="Enter"||a.key===" ")&&(a.preventDefault(),s())})}updateWidget(){if(!this.stats)return;this.animateValue("gh-repos",0,this.stats.repos,1e3),this.animateValue("gh-stars",0,this.stats.stars,1e3),this.animateValue("gh-followers",0,this.stats.followers,1e3);const t=document.getElementById("gh-languages");t&&(t.textContent=this.stats.topLanguages.join(", "));const e=document.getElementById("gh-latest-repo"),s=document.getElementById("gh-latest-time");e&&this.stats.latestRepo&&(e.textContent=this.stats.latestRepo.name,s.textContent=this.getTimeAgo(this.stats.latestRepo.updated_at))}animateValue(t,e,s,a){const o=document.getElementById(t);if(!o)return;this.animationTimers[t]&&clearInterval(this.animationTimers[t]);const n=(s-e)/(a/16);let r=e;this.animationTimers[t]=setInterval(()=>{r+=n,r>=s?(o.textContent=s,clearInterval(this.animationTimers[t]),this.animationTimers[t]=null):o.textContent=Math.floor(r)},16)}getTimeAgo(t){const e=new Date(t),a=Math.floor((new Date-e)/1e3),o={year:31536e3,month:2592e3,week:604800,day:86400,hour:3600,minute:60};for(const[d,n]of Object.entries(o)){const r=Math.floor(a/n);if(r>=1)return`${r} ${d}${r>1?"s":""} ago`}return"Just now"}}const githubStyles=document.createElement("style");githubStyles.textContent=`
    .github-stats-widget {
        position: fixed;
        bottom: 24px;
        left: 24px;
        width: 310px;
        background: var(--surface, #ffffff);
        border-radius: 16px;
        border: 1px solid var(--line, #dbeafe);
        box-shadow: var(--shadow-md, 0 12px 32px rgba(14, 116, 184, 0.12));
        z-index: 940;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .github-stats-widget.collapsed {
        width: max-content;
        border-radius: 999px;
    }

    .github-stats-widget.collapsed .github-widget-header {
        padding: 10px 16px;
        border-bottom-color: transparent;
    }

    .github-stats-widget.collapsed .github-widget-content {
        display: none;
    }

    .github-stats-widget.collapsed .widget-toggle i {
        transform: rotate(-90deg);
    }

    .github-widget-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        background: var(--surface-muted, #eef6ff);
        border-bottom: 1px solid var(--line, #dbeafe);
        cursor: pointer;
    }

    .github-widget-header i.fa-github {
        font-size: 18px;
        color: var(--brand, #0284c7);
        flex-shrink: 0;
    }

    .github-widget-header span {
        flex: 1;
        color: var(--text-strong, #0b1f33);
        font-weight: 600;
        font-size: 13.5px;
        white-space: nowrap;
        line-height: 1.2;
    }

    .widget-toggle {
        background: none;
        border: none;
        color: var(--muted, #5a728a);
        cursor: pointer;
        padding: 2px 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: color 0.2s ease;
    }

    .widget-toggle:hover {
        color: var(--brand, #0284c7);
    }

    .widget-toggle i {
        transition: transform 0.25s ease;
    }

    .github-widget-content {
        padding: 18px;
        max-height: 600px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .github-widget-content::-webkit-scrollbar {
        width: 6px;
    }

    .github-widget-content::-webkit-scrollbar-track {
        background: var(--surface-muted, #eef6ff);
        border-radius: 10px;
    }

    .github-widget-content::-webkit-scrollbar-thumb {
        background: var(--line-strong, #bfdbfe);
        border-radius: 10px;
    }

    .github-stat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 16px;
    }

    .github-stat-item {
        text-align: center;
        padding: 12px;
        background: var(--surface-muted, #eef6ff);
        border-radius: 12px;
        border: 1px solid var(--line, #dbeafe);
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .github-stat-item:hover {
        border-color: var(--brand, #0284c7);
        transform: translateY(-2px);
    }

    .github-stat-item i {
        font-size: 18px;
        color: var(--brand, #0284c7);
        margin-bottom: 6px;
    }

    .stat-value {
        font-size: 22px;
        font-weight: 700;
        color: var(--text-strong, #0b1f33);
        margin-bottom: 4px;
    }

    .github-stat-item--langs .stat-value {
        font-size: 13px;
        line-height: 1.35;
        min-height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        word-break: break-word;
    }

    .stat-label {
        font-size: 11px;
        color: var(--muted, #5a728a);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .github-latest-repo {
        background: var(--brand-soft, #e0f2fe);
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 14px;
        border-left: 3px solid var(--brand, #0284c7);
    }

    .repo-label {
        font-size: 11px;
        color: var(--muted, #5a728a);
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .repo-name {
        font-size: 14px;
        color: var(--brand-hover, #0369a1);
        font-weight: 700;
        margin-bottom: 3px;
    }

    .repo-time {
        font-size: 12px;
        color: var(--muted, #5a728a);
    }

    .github-profile-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 14px;
        background: linear-gradient(135deg, var(--brand-hover, #075985), var(--brand, #0369a1));
        color: var(--on-brand, #ffffff);
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        transition: filter 0.2s ease, transform 0.2s ease;
    }

    .github-profile-link:hover {
        transform: translateY(-2px);
        filter: brightness(1.06);
    }

    /* Mobile responsive */
    @media (max-width: 768px) {
        .github-stats-widget {
            left: 16px;
            right: 16px;
            width: auto;
            bottom: 74px;
            max-height: 68vh;
        }

        .github-stats-widget.collapsed {
            right: auto;
            bottom: 20px;
            width: max-content;
            max-width: calc(100vw - 180px);
        }

        .github-stats-widget.collapsed .github-widget-header {
            padding: 10px 12px;
            gap: 8px;
        }

        .github-stats-widget.collapsed .github-widget-header span {
            font-size: 12.5px;
            white-space: nowrap;
        }

        .github-widget-content {
            max-height: calc(68vh - 60px);
            padding: 15px;
        }

        .github-stat-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .github-stat-item {
            padding: 10px;
        }

        .stat-value {
            font-size: 20px;
        }
    }
`,document.head.appendChild(githubStyles),CONFIG.features.githubStats&&window.addEventListener("load",()=>{new GitHubStats});
