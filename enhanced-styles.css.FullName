.section-header{text-align:center;margin-bottom:60px;position:relative}.section-header:after{content:"";position:absolute;bottom:-20px;left:50%;transform:translate(-50%);width:72px;height:3.5px;background:linear-gradient(90deg,var(--brand),var(--accent));border-radius:999px}.section-badge{position:relative;padding-left:30px}.section-badge:before{content:"\2726";position:absolute;left:11px;color:var(--brand);font-size:14px}.stat-item{position:relative;overflow:hidden}.stat-icon{position:relative}.skills-category{position:relative;border-left:3px solid var(--brand);transition:transform .22s var(--ease-out),box-shadow .22s var(--ease-out)}.skills-category:hover{border-left-color:var(--accent);transform:translateY(-3px)}.category-header{position:relative;padding-left:60px}.category-header i{position:absolute;left:0;top:50%;transform:translateY(-50%);width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:var(--brand-soft);color:var(--brand);border-radius:12px;font-size:22px;transition:background .22s var(--ease-out),color .22s var(--ease-out)}.skills-category:hover .category-header i{background:var(--brand);color:var(--on-brand)}.skill-icon{position:relative}.progress-bar{position:relative;background:var(--surface-strong);border:1px solid var(--line)}.skill-info h4{display:flex;align-items:center;gap:8px}.skill-info h4:before{content:"\25b8";color:var(--brand);font-size:14px}.soft-skills h3{display:flex;align-items:center;justify-content:center;gap:12px;font-size:26px;color:var(--text-strong);margin-bottom:32px}.soft-skills h3 i{color:var(--brand)}.soft-skill-item{position:relative;cursor:pointer}.soft-skill-item i{background:var(--brand-soft);color:var(--brand);width:50px;height:50px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;border-radius:12px;transition:background .22s var(--ease-out),color .22s var(--ease-out)}.soft-skill-item:hover i{background:var(--brand);color:var(--on-brand)}.project-card,.blog-card,.achievement-card{position:relative}.project-card:after,.blog-card:after,.achievement-card:after{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--brand),var(--accent));transform:scaleX(0);transform-origin:left center;transition:transform .28s var(--ease-out);z-index:6;pointer-events:none}.project-card:hover:after,.blog-card:hover:after,.achievement-card:hover:after{transform:scaleX(1)}.achievement-badge{box-shadow:0 4px 14px color-mix(in srgb,var(--brand) 28%,transparent)}.btn{position:relative;overflow:hidden;z-index:1}.btn i{transition:transform .22s var(--ease-out)}.btn:hover i{transform:translate(2px)}.social-links a,.form-group{position:relative}.form-group label{position:absolute;top:-10px;left:50px;background:var(--surface);padding:0 8px;color:var(--brand);font-size:12px;font-weight:600;opacity:0;transition:opacity .2s}.form-group input:focus+label,.form-group textarea:focus+label{opacity:1}.scroll-down a{position:relative}.info-card{border-left:3px solid transparent;transition:transform .22s var(--ease-out),border-color .22s var(--ease-out),box-shadow .22s var(--ease-out)}.info-card:hover{border-left-color:var(--brand)}@media (max-width: 768px){.category-header{padding-left:0;flex-direction:column;text-align:center}.category-header i{position:relative;transform:none;margin-bottom:10px}.soft-skills h3{flex-direction:column}}@media print{.navbar,.scroll-top,.scroll-down,.hero-buttons,.social-links,.projects-filter{display:none!important}section{page-break-inside:avoid}}
