(function(){const u=window.matchMedia("(prefers-reduced-motion: reduce)").matches;function d(t,e,r){if(u){t.textContent=e.toLocaleString("vi-VN")+(r||"");return}const n=650,f=performance.now(),a=0;function c(l){const i=Math.min((l-f)/n,1),h=1-Math.pow(1-i,3),v=Math.round(a+(e-a)*h);t.textContent=v.toLocaleString("vi-VN")+(r||""),i<1&&requestAnimationFrame(c)}requestAnimationFrame(c)}function m(t){const e=String(t).match(/([\d.,]+)\s*(.*)/);return e?{num:parseInt(e[1].replace(/[.,]/g,""),10),suffix:e[2]||""}:null}const o=new IntersectionObserver(t=>{t.forEach(e=>{if(!e.isIntersecting)return;const r=e.target;if(r.dataset.animated==="true")return;const n=m(r.dataset.count);n&&!Number.isNaN(n.num)&&d(r,n.num,n.suffix),r.dataset.animated="true",r.closest(".home-stat")?.classList.add("is-visible"),o.unobserve(r)})},{threshold:.15});document.querySelectorAll("[data-count]").forEach(t=>o.observe(t));const s=new IntersectionObserver(t=>{t.forEach(e=>{e.isIntersecting&&(e.target.classList.add("is-visible"),s.unobserve(e.target))})},{threshold:.08,rootMargin:"0px 0px 40px 0px"});document.querySelectorAll(".home-service, .home-featured .project-card, .home-skill-group, .home-about").forEach(t=>s.observe(t))})();
