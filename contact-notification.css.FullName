.contact-notification{position:fixed;top:100px;right:30px;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--brand);padding:15px 20px;border-radius:12px;box-shadow:var(--shadow-md);display:flex;align-items:center;gap:12px;z-index:10000;opacity:0;transform:translate(400px);transition:all .25s var(--ease-out);max-width:400px}.contact-notification.show{opacity:1;transform:translate(0)}.contact-notification i{font-size:20px;flex-shrink:0}.contact-notification span{color:var(--text-strong);font-size:14px;line-height:1.5}.contact-notification.success{border-left-color:#059669}.contact-notification.success i{color:#059669}.contact-notification.error{border-left-color:#dc2626}.contact-notification.error i{color:#dc2626}.contact-notification.warning{border-left-color:#d97706}.contact-notification.warning i{color:#d97706}.contact-notification.info{border-left-color:var(--brand, #0284c7)}.contact-notification.info i{color:var(--brand, #0284c7)}button .fa-spinner{animation:spin 1s linear infinite}@keyframes spin{0%{transform:rotate(0)}to{transform:rotate(360deg)}}@media (max-width: 768px){.contact-notification{right:15px;left:15px;max-width:none}}
